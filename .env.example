# Runtime environment names are documented only; do not commit real values.
NODE_ENV=development

# PostgreSQL and queue
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis?schema=public
REDIS_URL=redis://localhost:6379

# Clerk (web uses publishable key; API validates tokens against issuer/JWKS)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
CLERK_WEBHOOK_SIGNING_SECRET=

# Private evidence storage (local development uses MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=aegis-evidence
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Secret manager and AI/model gateway references
SECRETS_PROVIDER=
MODEL_GATEWAY_URL=
MODEL_GATEWAY_API_KEY=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
